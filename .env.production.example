# Prod (AWS demo, http sin TLS). El BFF (server/api/auth/*) habla con esta base;
# el navegador nunca la toca directo (mismo origen → sin CORS para auth).
# Copiar a .env.production o exportar en el host y reiniciar Nitro.
NUXT_PUBLIC_API_AUTH_BASE=http://52.203.252.87:3000

# El resto de bases se mantienen según cada ambiente.
# TODO: puertos/URLs reales cuando los equipos de Profile y Appointments los confirmen.
NUXT_PUBLIC_API_PROFILE_BASE=http://127.0.0.1:8080
NUXT_PUBLIC_API_APPOINTMENTS_BASE=http://3.224.127.142:8002/api/v1

# Nota reset: el link del correo (/reset#token=...) lo arma Auth con su
# PORTAL_BASE_URL (SSM /kenko/dev/portal_base_url, hoy http://localhost:3000).
# Cuando haya URL final del portal, pasarla al equipo Auth para que actualice
# SSM + reinicie el contenedor. Este front ya lee el token del # sin cambios.
