# Requerido por nuxt-auth-utils (minimo 32 caracteres).
# Generar con: openssl rand -base64 32
NUXT_APP_SECRET=changeme-genera-uno-de-al-menos-32-caracteres

# Puerto de este frontend en local (`bun run dev` → http://localhost:3000).
# IMPORTANTE: el microservicio Auth debe apuntar a esta misma URL con su
# variable `PORTAL_BASE_URL` (p. ej. `PORTAL_BASE_URL=http://localhost:3000`).
# Auth construye con ella el enlace de recuperación (`/reset#token=…`) que
# llega por correo; si apunta a otro puerto, el enlace no abre este portal.
PORTAL_BASE_URL=http://localhost:3000

# Bases de microservicios (runtimeConfig.public; el BFF las lee con process.env).
# Auth SIEMPRE al desplegado (AWS demo). Local solo si levantas el microservicio
# en http://localhost:5500. Reiniciar Nitro al cambiarla.
NUXT_PUBLIC_API_AUTH_BASE=http://52.203.252.87:3000
# TODO: puertos reales cuando los equipos de Profile y Appointments los confirmen.
NUXT_PUBLIC_API_PROFILE_BASE=http://127.0.0.1:8080
NUXT_PUBLIC_API_APPOINTMENTS_BASE=http://3.224.127.142:8002/api/v1
