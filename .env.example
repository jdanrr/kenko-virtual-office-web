# Requerido por nuxt-auth-utils (minimo 32 caracteres).
# Generar con: openssl rand -base64 32
NUXT_SESSION_PASSWORD=changeme-genera-uno-de-al-menos-32-caracteres

# Bases de microservicios (para el proxy BFF en server/api/*, a implementar despues)
NUXT_PUBLIC_API_AUTH_BASE=http://localhost:8001
NUXT_PUBLIC_API_CITAS_BASE=http://localhost:8002
NUXT_PUBLIC_API_PROFILE_BASE=http://localhost:8003
